# Replace this placeholder with a strong, unique development API key.
API_KEY=replace-with-a-strong-random-secret

# Local host settings; Docker Compose overrides service URLs inside containers.
DATABASE_URL=postgresql+psycopg://your_user:your_password@localhost:5432/dgms
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434

# Generation model
LLM_MODEL=llama3:latest

# Optional application settings
QUERY_CACHE_TTL=300
RATE_LIMIT=60
RATE_LIMIT_WINDOW=60
